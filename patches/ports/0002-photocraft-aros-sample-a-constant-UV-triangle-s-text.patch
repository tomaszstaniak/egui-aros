From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: egui-aros <egui-aros@invalid>
Date: Mon, 19 Oct 2026 12:27:00 +0200
Subject: [PATCH] photocraft-aros: sample a constant-UV triangle's texture once

egui fills shapes with the font atlas's white texel: all three vertices of
such a triangle have the same UV, so every pixel samples the same point
(bilinear sampling included). Sample it once per triangle; with a flat
vertex colour the whole source colour is then constant too. The arithmetic
is the same as on the per-pixel path, so the pixels are unchanged.

Measured in the WordCraft AROS port (x86_64 ABIv11, AROS One 1.3, QEMU TCG,
three runs per size, identical screenshots): typing latency median from
2.58 to 0.88 s at 1008x720 and from 1.10 to 0.39 s at 640x480. The gain
depends on how much of a frame is solid fills; it is not a promise for
other programs or for real hardware.
---
 .../photocraft/photocraft-aros/src/raster.rs  | 25 +++++++++++++++----
 1 file changed, 20 insertions(+), 5 deletions(-)

diff --git a/graphics/photocraft/photocraft-aros/src/raster.rs b/graphics/photocraft/photocraft-aros/src/raster.rs
index d591fdd64e0931c22d7681416daaf24d4ca44f48..edf60101425e29dae726512f25fc9033e3d28b50 100644
--- a/graphics/photocraft/photocraft-aros/src/raster.rs
+++ b/graphics/photocraft/photocraft-aros/src/raster.rs
@@ -176,6 +176,19 @@ fn triangle(frame: &mut [u8], width: usize, clip: [i32; 4], ppp: f32, texture: O
     let cb = b.color.to_array();
     let cc = c.color.to_array();
     let flat_color = ca == cb && cb == cc;
+    // A triangle whose three UVs are equal samples one point of its texture at every pixel
+    // (egui's fills use the atlas's white texel): sample once. With a flat colour, the whole
+    // source colour is the same everywhere too. Same arithmetic as the per-pixel path.
+    let modulate =
+        |color: [f32; 4], s: [f32; 4]| [color[0] * s[0] / 255.0, color[1] * s[1] / 255.0, color[2] * s[2] / 255.0, color[3] * s[3] / 255.0];
+    let uniform = (a.uv == b.uv && b.uv == c.uv).then(|| texture.map(|t| t.sample(a.uv.x, a.uv.y)));
+    let flat_src = match uniform {
+        Some(sample) if flat_color => {
+            let color = [ca[0] as f32, ca[1] as f32, ca[2] as f32, ca[3] as f32];
+            Some(sample.map_or(color, |s| modulate(color, s)))
+        }
+        _ => None,
+    };
     // How each edge function changes per pixel step to the right (d/dx of the expressions below).
     let e0_dx = by - cy;
     let e1_dx = cy - ay;
@@ -209,6 +222,7 @@ fn triangle(frame: &mut [u8], width: usize, clip: [i32; 4], ppp: f32, texture: O
                 let l0 = w0 * inv_area;
                 let l1 = w1 * inv_area;
                 let l2 = w2 * inv_area;
+                let src = if let Some(src) = flat_src { src } else {
                 let color = if flat_color {
                     [ca[0] as f32, ca[1] as f32, ca[2] as f32, ca[3] as f32]
                 } else {
@@ -218,14 +232,15 @@ fn triangle(frame: &mut [u8], width: usize, clip: [i32; 4], ppp: f32, texture: O
                     }
                     v
                 };
-                let src = match texture {
-                    Some(t) => {
+                match (uniform, texture) {
+                    (Some(Some(s)), _) => modulate(color, s),
+                    (_, Some(t)) => {
                         let u = a.uv.x * l0 + b.uv.x * l1 + c.uv.x * l2;
                         let v = a.uv.y * l0 + b.uv.y * l1 + c.uv.y * l2;
-                        let s = t.sample(u, v);
-                        [color[0] * s[0] / 255.0, color[1] * s[1] / 255.0, color[2] * s[2] / 255.0, color[3] * s[3] / 255.0]
+                        modulate(color, t.sample(u, v))
                     }
-                    None => color,
+                    (_, None) => color,
+                }
                 };
                 let alpha = src[3];
                 if alpha > 0.0 {
