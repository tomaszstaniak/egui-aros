From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: egui-aros <egui-aros@invalid>
Date: Mon, 19 Oct 2026 12:26:47 +0200
Subject: [PATCH] photocraft-aros: draw pixels on a shared triangle edge once
 (top-left rule)

The software renderer's inside test accepts a pixel when all three edge
functions are >= 0, so a pixel whose centre lies exactly on the edge two
triangles share is drawn by both. Where the triangles are translucent the
pixel is blended twice, which shows as a line: egui draws every image as a
quad of two triangles, and at integer positions its diagonal passes through
a pixel centre on every row (seen on x86_64 ABIv11, AROS One 1.3, QEMU).

Apply the top-left rule of D3D and GL rasterizers (y down): a pixel on an
edge belongs to the triangle for which that edge is a left edge (the edge
function grows to the right) or a top edge (horizontal, growing downwards).
Pixels not exactly on an edge are unaffected.

Test: raster::tests::shared_edges_are_drawn_once draws three quads, split
along either diagonal, with a translucent colour over black and checks that
no pixel is drawn twice. In the egui-aros copy of this renderer the same
test fails without the change (128 of a 128x128 quad's pixels drawn twice)
and passes with it.
---
 .../photocraft/photocraft-aros/src/raster.rs  | 55 ++++++++++++++++++-
 1 file changed, 52 insertions(+), 3 deletions(-)

diff --git a/graphics/photocraft/photocraft-aros/src/raster.rs b/graphics/photocraft/photocraft-aros/src/raster.rs
index 7c78e6da243c444df06dcf136a5282f33619e56d..d591fdd64e0931c22d7681416daaf24d4ca44f48 100644
--- a/graphics/photocraft/photocraft-aros/src/raster.rs
+++ b/graphics/photocraft/photocraft-aros/src/raster.rs
@@ -180,17 +180,32 @@ fn triangle(frame: &mut [u8], width: usize, clip: [i32; 4], ppp: f32, texture: O
     let e0_dx = by - cy;
     let e1_dx = cy - ay;
     let e2_dx = ay - by;
+    // Normalized to the triangle's winding: inside when all three are >= 0.
+    let sign = if area > 0.0 { 1.0 } else { -1.0 };
+    // A pixel centre exactly on an edge belongs to one triangle only (the top-left rule of
+    // D3D and GL rasterizers, y down): to the one whose edge is a left edge (the function grows
+    // to the right) or a top edge (horizontal, growing downwards). Without it, a pixel on the
+    // edge two triangles share was drawn by both, which shows as a line where they are
+    // translucent (the diagonal of every image quad at integer positions).
+    let top_left = |dx: f32, dy: f32| {
+        let (dx, dy) = (dx * sign, dy * sign);
+        dx > 0.0 || (dx == 0.0 && dy > 0.0)
+    };
+    // d/dy of the three edge functions.
+    let (tl0, tl1, tl2) = (top_left(e0_dx, cx - bx), top_left(e1_dx, ax - cx), top_left(e2_dx, bx - ax));
+    let inside = |w: f32, tl: bool| {
+        let w = w * sign;
+        w > 0.0 || (w == 0.0 && tl)
+    };
     for py in min_y..max_y {
         let sy = py as f32 + 0.5;
         let sx0 = min_x as f32 + 0.5;
         let mut w0 = (bx - sx0) * (cy - sy) - (by - sy) * (cx - sx0);
         let mut w1 = (cx - sx0) * (ay - sy) - (cy - sy) * (ax - sx0);
         let mut w2 = (ax - sx0) * (by - sy) - (ay - sy) * (bx - sx0);
-        // Normalized to the triangle's winding: inside when all three are >= 0.
-        let sign = if area > 0.0 { 1.0 } else { -1.0 };
         let row = py as usize * width;
         for px in min_x..max_x {
-            if w0 * sign >= 0.0 && w1 * sign >= 0.0 && w2 * sign >= 0.0 {
+            if inside(w0, tl0) && inside(w1, tl1) && inside(w2, tl2) {
                 let l0 = w0 * inv_area;
                 let l1 = w1 * inv_area;
                 let l2 = w2 * inv_area;
@@ -237,3 +252,37 @@ fn triangle(frame: &mut [u8], width: usize, clip: [i32; 4], ppp: f32, texture: O
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Two triangles sharing an edge (a quad split along its diagonal, and a fan) cover every
+    /// pixel of their union exactly once: translucent quads show no seam.
+    #[test]
+    fn shared_edges_are_drawn_once() {
+        use egui::epaint::{Color32, Pos2};
+        let v = |x: f32, y: f32| Vertex { pos: Pos2::new(x, y), uv: Pos2::ZERO, color: Color32::from_rgba_premultiplied(100, 0, 0, 100) };
+        // A translucent colour over black: drawn once, red is 100; drawn twice, about 160.
+        let cases: [[(f32, f32); 4]; 3] = [
+            [(10.0, 10.0), (138.0, 10.0), (138.0, 138.0), (10.0, 138.0)],
+            [(3.5, 7.25), (90.0, 2.0), (120.0, 99.0), (5.0, 80.0)],
+            [(0.0, 0.0), (64.0, 0.0), (64.0, 64.0), (0.0, 64.0)],
+        ];
+        for quad in cases {
+            for diagonal in [0usize, 1] {
+                let (w, h) = (160usize, 160usize);
+                let mut frame = vec![0u8; w * h * 4];
+                let p: Vec<Vertex> = quad.iter().map(|&(x, y)| v(x, y)).collect();
+                let tris = if diagonal == 0 { [[0, 1, 2], [0, 2, 3]] } else { [[1, 2, 3], [1, 3, 0]] };
+                for [i, j, k] in tris {
+                    triangle(&mut frame, w, [0, 0, w as i32, h as i32], 1.0, None, &p[i], &p[j], &p[k]);
+                }
+                let twice = frame.chunks(4).filter(|px| px[0] > 110).count();
+                let once = frame.chunks(4).filter(|px| (90..=110).contains(&px[0])).count();
+                assert_eq!(twice, 0, "quad {quad:?} diagonal {diagonal}: {twice} pixels drawn twice");
+                assert!(once > 1000, "quad {quad:?}: only {once} pixels drawn");
+            }
+        }
+    }
+}
