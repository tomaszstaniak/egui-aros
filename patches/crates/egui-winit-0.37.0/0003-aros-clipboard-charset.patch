From: egui-aros
Subject: [PATCH] egui-winit (AROS): clipboard text in the system character set

Crate: egui-winit 0.37.0 (storytold/egui 6d518fc7) with 0001-0002.
Date: 2026-11-07
Problem: 0001 read and wrote clipboard text as ISO 8859-1. Polish text
  copied from another AROS program (ISO 8859-2 bytes) pasted as "±ê", and
  copied text lost every character outside ISO 8859-1 ("?").
Rationale: aros-gui-sys 0003 implements the AROS FTXT contract once: CHRS in
  the system character set, CSET 106 for UTF-8. The clipboard calls it.
Prerequisites: aros-gui-sys 0003-system-charset-and-ftxt-cset.patch.
Upstream-status: candidate for the AROS contrib crate store (not submitted).
Verification: see the egui-aros build records.
Removal: with 0001.
---
diff -ruN egui-winit-0.37.0.orig/src/clipboard.rs egui-winit-0.37.0/src/clipboard.rs
--- egui-winit-0.37.0.orig/src/clipboard.rs	2026-11-07 09:58:32
+++ egui-winit-0.37.0/src/clipboard.rs	2026-11-07 09:58:42
@@ -1132,30 +1132,17 @@
     }
 }
 
-/// The system clipboard (clipboard.device unit 0, IFF FTXT). FTXT text is
-/// ISO-8859-1: characters outside it are written as `?`.
-// The crate denies unsafe code; these are the only foreign calls it makes.
+/// The system clipboard (clipboard.device unit 0, IFF FTXT) through aros-gui-sys: the system
+/// character set, or UTF-8 with CSET 106 for text the set cannot hold.
 #[cfg(target_os = "aros")]
-#[allow(unsafe_code)]
 mod aros {
+    /// FTXT in the system character set, or UTF-8 under CSET 106 (aros-gui-sys `clipboard`).
     pub fn get() -> Option<String> {
-        let mut len = 0;
-        let text = unsafe { aros_gui_sys::aros_gui_clip_read(&mut len) };
-        if text.is_null() {
-            return None;
-        }
-        let bytes = unsafe { std::slice::from_raw_parts(text, len.max(0) as usize) };
-        let out = bytes.iter().map(|&b| char::from(b)).collect();
-        unsafe { aros_gui_sys::aros_gui_clip_free(text) };
-        Some(out)
+        aros_gui_sys::clipboard::read_text()
     }
 
     pub fn set(text: &str) -> bool {
-        let bytes: Vec<u8> = text.chars().map(|c| u8::try_from(u32::from(c)).unwrap_or(b'?')).collect();
-        let Ok(len) = i32::try_from(bytes.len()) else {
-            return false;
-        };
-        let ok = unsafe { aros_gui_sys::aros_gui_clip_write(bytes.as_ptr(), len) } == 0;
+        let ok = aros_gui_sys::clipboard::write_text(text);
         if !ok {
             log::error!("AROS clipboard write failed");
         }
