-[target.'cfg(not(target_os = "android"))'.dependencies.arboard]
+[target.'cfg(target_os = "aros")'.dependencies.aros-gui-sys]
+version = "0.1"
+
+[target.'cfg(not(any(target_os = "android", target_os = "aros")))'.dependencies.arboard]
