@@ -0,0 +1,382 @@
+use std::collections::VecDeque;
+use std::ffi::CString;
+use std::sync::atomic::Ordering;
+use std::sync::{Arc, Mutex};
+
+use aros_gui_sys as sys;
+
+use super::event_loop::Shared;
+use super::{ActiveEventLoop, MonitorHandle, OsError, WindowId};
+use crate::cursor::Cursor;
+use crate::dpi::{PhysicalPosition, PhysicalSize, Position, Size};
+use crate::platform_impl::Fullscreen;
+use crate::window::ImePurpose;
+use crate::{error, window};
+
+/// Default interior when the application asks for none.
+const DEFAULT_SIZE: (u32, u32) = (800, 600);
+
+pub struct Window {
+    handle: usize,
+    title: Mutex<String>,
+    resizable: bool,
+    decorated: bool,
+    shared: Arc<Shared>,
+}
+
+impl Window {
+    pub(crate) fn new(
+        el: &ActiveEventLoop,
+        attrs: window::WindowAttributes,
+    ) -> Result<Self, error::OsError> {
+        let scale = MonitorHandle.scale_factor();
+
+        let (left, top) = match attrs.position {
+            Some(position) => position.to_physical::<i32>(scale).into(),
+            None => (-1, -1),
+        };
+        let (width, height): (u32, u32) =
+            attrs.inner_size.map_or(DEFAULT_SIZE, |size| size.to_physical::<u32>(scale).into());
+        let (min_width, min_height): (u32, u32) =
+            attrs.min_inner_size.map_or((0, 0), |size| size.to_physical::<u32>(scale).into());
+
+        let mut flags = sys::AROS_GUI_WINDOW_ACTIVATE;
+        if attrs.resizable {
+            flags |= sys::AROS_GUI_WINDOW_RESIZABLE;
+        }
+        if !attrs.decorations {
+            flags |= sys::AROS_GUI_WINDOW_BORDERLESS;
+        }
+
+        let title = CString::new(attrs.title.replace('\0', "")).unwrap_or_default();
+        let raw_attrs = sys::aros_gui_window_attrs {
+            left,
+            top,
+            inner_width: width as i32,
+            inner_height: height as i32,
+            min_width: min_width as i32,
+            min_height: min_height as i32,
+            flags,
+            title: title.as_ptr(),
+        };
+        let mut info = sys::aros_gui_window_info::default();
+        if unsafe { sys::aros_gui_window_open(&raw_attrs, &mut info) } != 0 {
+            return Err(os_error!(OsError("Intuition could not open the window")));
+        }
+
+        // The loop picks the window up on its next iteration.
+        el.creates.lock().unwrap().push_back(info);
+        el.shared.waker.wake();
+
+        Ok(Self {
+            handle: info.handle,
+            title: Mutex::new(attrs.title),
+            resizable: attrs.resizable,
+            decorated: attrs.decorations,
+            shared: el.shared.clone(),
+        })
+    }
