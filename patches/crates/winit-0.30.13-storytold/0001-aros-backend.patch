index 0000000..9f0e17a
--- /dev/null
+++ b/src/platform_impl/aros/event_loop.rs
@@ -0,0 +1,495 @@
+use std::cell::Cell;
+use std::collections::VecDeque;
+use std::ffi::{c_int, c_void};
+use std::marker::PhantomData;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::Instant;
+
+use aros_gui_sys as sys;
+
+use super::keyboard;
+use super::{DeviceId, MonitorHandle, OsError, PlatformSpecificEventLoopAttributes, WindowId};
+use crate::error::EventLoopError;
+use crate::event::{
+    self, DeviceEvent, ElementState, MouseButton, MouseScrollDelta, StartCause, TouchPhase,
+};
+use crate::event_loop::{self, ControlFlow, DeviceEvents};
+use crate::window::{CustomCursor as RootCustomCursor, CustomCursorSource, Theme};
+
+/// Wakes the event loop from any thread by signalling its task.
+#[derive(Debug)]
+pub(super) struct Waker {
+    task: usize,
+    mask: u32,
+}
+
+impl Waker {
+    pub(super) fn wake(&self) {
+        unsafe { sys::aros_gui_signal_send(self.task as *mut c_void, self.mask) };
+    }
+}
+
+/// State shared between the event loop and its windows and proxies.
+#[derive(Debug)]
+pub(super) struct Shared {
+    pub(super) redraws: Mutex<VecDeque<WindowId>>,
+    /// Windows dropped while the loop runs. The loop closes them itself, so
+    /// it never reads a port that `CloseWindow` has freed.
+    pub(super) destroys: Mutex<VecDeque<usize>>,
+    pub(super) running: AtomicBool,
+    pub(super) waker: Waker,
+}
+
+/// A window the loop reads messages from.
+struct WindowState {
+    info: sys::aros_gui_window_info,
+    qualifier: u16,
+    cursor: (i32, i32),
+}
+
+impl WindowState {
+    fn id(&self) -> WindowId {
+        WindowId { handle: self.info.handle as u64 }
+    }
+}
+
+pub struct EventLoop<T: 'static> {
+    windows: Vec<WindowState>,
+    window_target: event_loop::ActiveEventLoop,
+    wake_bit: c_int,
+    user_events_sender: mpsc::Sender<T>,
+    user_events_receiver: mpsc::Receiver<T>,
+}
+
+impl<T: 'static> EventLoop<T> {
+    pub(crate) fn new(_: &PlatformSpecificEventLoopAttributes) -> Result<Self, EventLoopError> {
+        let wake_bit = unsafe { sys::aros_gui_signal_alloc() };
+        if wake_bit < 0 {
+            return Err(EventLoopError::Os(os_error!(OsError("no free signal bit"))));
+        }
+        let task = unsafe { sys::aros_gui_task_self() } as usize;
+        let (user_events_sender, user_events_receiver) = mpsc::channel();
+
+        Ok(Self {
+            windows: Vec::new(),
+            window_target: event_loop::ActiveEventLoop {
+                p: ActiveEventLoop {
+                    control_flow: Cell::new(ControlFlow::default()),
+                    exit: Cell::new(false),
+                    creates: Mutex::new(VecDeque::new()),
+                    shared: Arc::new(Shared {
+                        redraws: Mutex::new(VecDeque::new()),
+                        destroys: Mutex::new(VecDeque::new()),
+                        running: AtomicBool::new(true),
+                        waker: Waker { task, mask: 1 << wake_bit },
+                    }),
+                },
+                _marker: PhantomData,
+            },
+            wake_bit,
+            user_events_sender,
+            user_events_receiver,
+        })
+    }
+
+    fn shared(&self) -> &Arc<Shared> {
+        &self.window_target.p.shared
+    }
+
+    fn destroy_pending(&self, handle: usize) -> bool {
+        self.shared().destroys.lock().unwrap().contains(&handle)
+    }
+
+    fn close_destroyed<F>(&mut self, event_handler: &mut F)
+    where
+        F: FnMut(event::Event<T>, &event_loop::ActiveEventLoop),
+    {
+        loop {
+            // Popped in its own statement so the lock is released before the handler runs.
+            let Some(handle) = self.shared().destroys.lock().unwrap().pop_front() else { break };
+            let id = WindowId { handle: handle as u64 };
+            unsafe { sys::aros_gui_window_close(handle) };
+            self.windows.retain(|window| window.info.handle != handle);
+            self.shared().redraws.lock().unwrap().retain(|redraw| *redraw != id);
+            event_handler(
+                event::Event::WindowEvent {
+                    window_id: crate::window::WindowId(id),
+                    event: event::WindowEvent::Destroyed,
+                },
+                &self.window_target,
+            );
+        }
+    }
+
+    fn send_modifiers<F>(window: &mut WindowState, qualifier: u16, mut send: F)
+    where
+        F: FnMut(event::WindowEvent),
+    {
+        let before = keyboard::modifiers(window.qualifier);
+        window.qualifier = qualifier;
+        let after = keyboard::modifiers(qualifier);
+        if before != after {
+            send(event::WindowEvent::ModifiersChanged(after));
+        }
+    }
+
+    fn process_message<F>(
+        window: &mut WindowState,
+        msg: sys::aros_gui_message,
+        redraws: &Mutex<VecDeque<WindowId>>,
+        mut send_any: F,
+    ) where
+        F: FnMut(event::Event<T>),
+    {
+        let device_id = event::DeviceId(DeviceId);
+        let window_id = crate::window::WindowId(window.id());
+        // Macros rather than closures: both kinds of event go through the one
+        // handler, which a closure would hold on to.
+        macro_rules! send {
+            ($event:expr) => {
+                send_any(event::Event::WindowEvent { window_id, event: $event })
+            };
+        }
+        macro_rules! send_device {
+            ($event:expr) => {
+                send_any(event::Event::DeviceEvent { device_id, event: $event })
+            };
+        }
+
+        match msg.class {
+            sys::IDCMP_CLOSEWINDOW => send!(event::WindowEvent::CloseRequested),
+            sys::IDCMP_ACTIVEWINDOW => send!(event::WindowEvent::Focused(true)),
+            sys::IDCMP_INACTIVEWINDOW => send!(event::WindowEvent::Focused(false)),
+            sys::IDCMP_NEWSIZE | sys::IDCMP_CHANGEWINDOW => {
+                let old = window.info;
+                unsafe { sys::aros_gui_window_info(old.handle, &mut window.info) };
+                let new = window.info;
+                if (new.left, new.top) != (old.left, old.top) {
+                    send!(event::WindowEvent::Moved((new.left, new.top).into()));
+                }
+                if (new.inner_width, new.inner_height) != (old.inner_width, old.inner_height) {
+                    send!(event::WindowEvent::Resized(
+                        (new.inner_width as u32, new.inner_height as u32).into(),
+                    ));
+                    let mut redraws = redraws.lock().unwrap();
+                    if !redraws.contains(&window.id()) {
+                        redraws.push_back(window.id());
+                    }
+                }
+            },
+            sys::IDCMP_MOUSEMOVE => {
+                // With the pointer grabbed the window is in IDCMP_DELTAMOVE
+                // mode and reports movements, which go out as device motion.
+                if unsafe { sys::aros_gui_window_delta_move(window.info.handle) } != 0 {
+                    if (msg.mouse_x, msg.mouse_y) != (0, 0) {
+                        send_device!(DeviceEvent::MouseMotion {
+                            delta: (msg.mouse_x as f64, msg.mouse_y as f64),
+                        });
+                    }
+                    return;
+                }
+                window.cursor = (msg.mouse_x, msg.mouse_y);
+                send!(event::WindowEvent::CursorMoved {
+                    device_id,
+                    position: (msg.mouse_x as f64, msg.mouse_y as f64).into(),
+                });
+            },
+            sys::IDCMP_MOUSEBUTTONS => {
+                Self::send_modifiers(window, msg.qualifier, &mut |event| send_any(event::Event::WindowEvent { window_id, event }));
+                if window.cursor != (msg.mouse_x, msg.mouse_y) {
+                    window.cursor = (msg.mouse_x, msg.mouse_y);
+                    send!(event::WindowEvent::CursorMoved {
+                        device_id,
+                        position: (msg.mouse_x as f64, msg.mouse_y as f64).into(),
+                    });
+                }
+                let button = match msg.code & !sys::IECODE_UP_PREFIX {
+                    sys::IECODE_LBUTTON => MouseButton::Left,
+                    sys::IECODE_RBUTTON => MouseButton::Right,
+                    sys::IECODE_MBUTTON => MouseButton::Middle,
+                    _ => return,
+                };
+                let state = if msg.code & sys::IECODE_UP_PREFIX != 0 {
+                    ElementState::Released
+                } else {
+                    ElementState::Pressed
+                };
+                send!(event::WindowEvent::MouseInput { device_id, state, button });
+            },
+            sys::IDCMP_RAWKEY => {
+                let delta = match msg.code {
+                    keyboard::RAWKEY_NM_WHEEL_UP => Some((0.0, 1.0)),
+                    keyboard::RAWKEY_NM_WHEEL_DOWN => Some((0.0, -1.0)),
+                    keyboard::RAWKEY_NM_WHEEL_LEFT => Some((1.0, 0.0)),
+                    keyboard::RAWKEY_NM_WHEEL_RIGHT => Some((-1.0, 0.0)),
+                    code if code & !sys::IECODE_UP_PREFIX >= keyboard::RAWKEY_NM_WHEEL_UP
+                        && code & !sys::IECODE_UP_PREFIX <= keyboard::RAWKEY_NM_WHEEL_RIGHT =>
+                    {
+                        // The wheel's release half carries nothing.
+                        return;
+                    },
+                    _ => None,
+                };
+                if let Some((x, y)) = delta {
+                    send!(event::WindowEvent::MouseWheel {
+                        device_id,
+                        delta: MouseScrollDelta::LineDelta(x, y),
+                        phase: TouchPhase::Moved,
+                    });
+                    return;
+                }
+
+                let qualifier = keyboard::qualifier_after(msg.code, msg.qualifier);
+                let key = event::WindowEvent::KeyboardInput {
+                    device_id,
+                    event: keyboard::key_event(msg.code, msg.qualifier),
+                    is_synthetic: false,
+                };
+                // A modifier key reports itself first, like the other backends;
+                // any other key is seen under the modifiers already in effect.
+                if keyboard::is_modifier_key(msg.code) {
+                    send!(key);
+                    Self::send_modifiers(window, qualifier, &mut |event| send_any(event::Event::WindowEvent { window_id, event }));
+                } else {
+                    Self::send_modifiers(window, qualifier, &mut |event| send_any(event::Event::WindowEvent { window_id, event }));
+                    send!(key);
+                }
+            },
+            _ => (),
+        }
+    }
+
+    pub fn run<F>(mut self, mut event_handler: F) -> Result<(), EventLoopError>
+    where
+        F: FnMut(event::Event<T>, &event_loop::ActiveEventLoop),
+    {
+        let mut start_cause = StartCause::Init;
+
+        loop {
+            event_handler(event::Event::NewEvents(start_cause), &self.window_target);
+
+            if start_cause == StartCause::Init {
+                event_handler(event::Event::Resumed, &self.window_target);
+            }
+
+            // Windows opened since the last iteration.
+            loop {
+                let Some(info) = self.window_target.p.creates.lock().unwrap().pop_front() else {
+                    break;
+                };
+                let window =
+                    WindowState { info, qualifier: 0, cursor: (i32::MIN, i32::MIN) };
+                let id = window.id();
+                self.windows.push(window);
+                event_handler(
+                    event::Event::WindowEvent {
+                        window_id: crate::window::WindowId(id),
+                        event: event::WindowEvent::Resized(
+                            (info.inner_width as u32, info.inner_height as u32).into(),
+                        ),
+                    },
+                    &self.window_target,
+                );
+            }
+
+            self.close_destroyed(&mut event_handler);
+
+            // IDCMP messages. Stop reading a window as soon as it is dropped.
+            let mut i = 0;
+            while i < self.windows.len() {
+                let handle = self.windows[i].info.handle;
+                let id = crate::window::WindowId(self.windows[i].id());
+                loop {
+                    if self.destroy_pending(handle) {
+                        break;
+                    }
+                    let mut msg = sys::aros_gui_message::default();
+                    if unsafe { sys::aros_gui_window_next_message(handle, &mut msg) } == 0 {
+                        break;
+                    }
+                    let target = &self.window_target;
+                    Self::process_message(
+                        &mut self.windows[i],
+                        msg,
+                        &target.p.shared.redraws,
+                        |event| event_handler(event, target),
+                    );
+                }
+                i += 1;
+            }
+
+            while let Ok(event) = self.user_events_receiver.try_recv() {
+                event_handler(event::Event::UserEvent(event), &self.window_target);
+            }
+
+            // The lock is not held while the handler runs, which may request more.
+            loop {
+                let Some(id) = self.shared().redraws.lock().unwrap().pop_front() else { break };
+                event_handler(
+                    event::Event::WindowEvent {
+                        window_id: crate::window::WindowId(id),
+                        event: event::WindowEvent::RedrawRequested,
+                    },
+                    &self.window_target,
+                );
+            }
+
+            event_handler(event::Event::AboutToWait, &self.window_target);
+
+            self.close_destroyed(&mut event_handler);
+
+            if self.window_target.p.exiting() {
+                break;
+            }
+
+            let requested_resume = match self.window_target.p.control_flow() {
+                ControlFlow::Poll => {
+                    start_cause = StartCause::Poll;
+                    continue;
+                },
+                ControlFlow::Wait => None,
+                ControlFlow::WaitUntil(instant) => Some(instant),
+            };
+
+            // Anything queued by the handler wakes the loop straight away.
+            let mut mask = self.shared().waker.mask;
+            for window in &self.windows {
+                mask |= window.info.sigmask;
+            }
+            let start = Instant::now();
+            let timeout_us = match requested_resume {
+                None => -1,
+                Some(instant) => instant
+                    .checked_duration_since(start)
+                    .map_or(0, |d| d.as_micros().min(i64::MAX as u128) as i64),
+            };
+            let mut timed_out = 0;
+            unsafe { sys::aros_gui_wait(mask, timeout_us, &mut timed_out) };
+
+            start_cause = match requested_resume {
+                Some(requested_resume) if timed_out != 0 => {
+                    StartCause::ResumeTimeReached { start, requested_resume }
+                },
+                _ => StartCause::WaitCancelled { start, requested_resume },
+            };
+        }
+
+        event_handler(event::Event::LoopExiting, &self.window_target);
+
+        // Windows still alive close themselves when dropped from here on.
+        self.shared().running.store(false, Ordering::SeqCst);
+        self.close_destroyed(&mut |_, _| ());
+        unsafe {
+            sys::aros_gui_signal_free(self.wake_bit);
+            sys::aros_gui_wait_cleanup();
+        }
+
+        Ok(())
+    }
+
+    pub fn window_target(&self) -> &event_loop::ActiveEventLoop {
+        &self.window_target
+    }
+
+    pub fn create_proxy(&self) -> EventLoopProxy<T> {
+        EventLoopProxy {
+            user_events_sender: self.user_events_sender.clone(),
+            shared: self.shared().clone(),
+        }
+    }
+}
+
+pub struct EventLoopProxy<T: 'static> {
+    user_events_sender: mpsc::Sender<T>,
+    shared: Arc<Shared>,
+}
+
+impl<T> EventLoopProxy<T> {
+    pub fn send_event(&self, event: T) -> Result<(), event_loop::EventLoopClosed<T>> {
+        self.user_events_sender
+            .send(event)
+            .map_err(|mpsc::SendError(x)| event_loop::EventLoopClosed(x))?;
+        self.shared.waker.wake();
+        Ok(())
+    }
+}
+
+impl<T> Clone for EventLoopProxy<T> {
+    fn clone(&self) -> Self {
+        Self { user_events_sender: self.user_events_sender.clone(), shared: self.shared.clone() }
+    }
+}
+
+impl<T> Unpin for EventLoopProxy<T> {}
+
+pub struct ActiveEventLoop {
+    control_flow: Cell<ControlFlow>,
+    exit: Cell<bool>,
+    pub(super) creates: Mutex<VecDeque<sys::aros_gui_window_info>>,
+    pub(super) shared: Arc<Shared>,
+}
+
+impl ActiveEventLoop {
+    pub fn create_custom_cursor(&self, source: CustomCursorSource) -> RootCustomCursor {
+        let _ = source.inner;
+        RootCustomCursor { inner: super::PlatformCustomCursor }
+    }
+
+    pub fn primary_monitor(&self) -> Option<MonitorHandle> {
+        Some(MonitorHandle)
+    }
+
+    pub fn available_monitors(&self) -> VecDeque<MonitorHandle> {
+        VecDeque::from([MonitorHandle])
+    }
+
+    #[inline]
+    pub fn listen_device_events(&self, _allowed: DeviceEvents) {}
+
+    #[inline]
+    pub fn system_theme(&self) -> Option<Theme> {
+        None
+    }
+
+    #[cfg(feature = "rwh_06")]
+    #[inline]
+    pub fn raw_display_handle_rwh_06(
+        &self,
+    ) -> Result<rwh_06::RawDisplayHandle, rwh_06::HandleError> {
+        Ok(rwh_06::RawDisplayHandle::Aros(rwh_06::ArosDisplayHandle::new()))
+    }
+
+    pub fn set_control_flow(&self, control_flow: ControlFlow) {
+        self.control_flow.set(control_flow)
+    }
+
+    pub fn control_flow(&self) -> ControlFlow {
+        self.control_flow.get()
+    }
+
+    pub(crate) fn exit(&self) {
+        self.exit.set(true);
+    }
+
+    pub(crate) fn exiting(&self) -> bool {
+        self.exit.get()
+    }
+
+    pub(crate) fn owned_display_handle(&self) -> OwnedDisplayHandle {
+        OwnedDisplayHandle
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct OwnedDisplayHandle;
+
+impl OwnedDisplayHandle {
+    #[cfg(feature = "rwh_06")]
+    #[inline]
+    pub fn raw_display_handle_rwh_06(
+        &self,
+    ) -> Result<rwh_06::RawDisplayHandle, rwh_06::HandleError> {
+        Ok(rwh_06::ArosDisplayHandle::new().into())
+    }
+}
