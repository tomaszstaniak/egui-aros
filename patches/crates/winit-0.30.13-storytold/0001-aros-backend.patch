+
+impl Drop for Window {
+    fn drop(&mut self) {
+        if self.shared.running.load(Ordering::SeqCst) {
+            self.shared.destroys.lock().unwrap().push_back(self.handle);
+            self.shared.waker.wake();
+        } else {
+            // The loop is gone; this is still the task that opened the window.
+            unsafe { sys::aros_gui_window_close(self.handle) };
+        }
+    }
