index 0000000..37b0a69
--- /dev/null
+++ b/src/platform_impl/aros/keyboard.rs
@@ -0,0 +1,362 @@
+//! Amiga raw key codes, qualifiers and the keymap.
+
+use std::ffi::{c_char, c_int};
+
+use aros_gui_sys as sys;
+use smol_str::SmolStr;
+
+use super::KeyEventExtra;
+use crate::event::{ElementState, KeyEvent, Modifiers};
+use crate::keyboard::{
+    Key, KeyCode, KeyLocation, ModifiersKeys, ModifiersState, NamedKey, NativeKey, NativeKeyCode,
+    PhysicalKey,
+};
+
+// NewMouse wheel codes, devices/rawkeycodes.h.
+pub(super) const RAWKEY_NM_WHEEL_UP: u16 = 0x7A;
+pub(super) const RAWKEY_NM_WHEEL_DOWN: u16 = 0x7B;
+pub(super) const RAWKEY_NM_WHEEL_LEFT: u16 = 0x7C;
+pub(super) const RAWKEY_NM_WHEEL_RIGHT: u16 = 0x7D;
+
+/// Physical keys by raw code, devices/rawkeycodes.h.
+const KEYS: &[(u16, KeyCode)] = &[
+    (0x00, KeyCode::Backquote),
+    (0x01, KeyCode::Digit1),
+    (0x02, KeyCode::Digit2),
+    (0x03, KeyCode::Digit3),
+    (0x04, KeyCode::Digit4),
+    (0x05, KeyCode::Digit5),
+    (0x06, KeyCode::Digit6),
+    (0x07, KeyCode::Digit7),
+    (0x08, KeyCode::Digit8),
+    (0x09, KeyCode::Digit9),
+    (0x0A, KeyCode::Digit0),
+    (0x0B, KeyCode::Minus),
+    (0x0C, KeyCode::Equal),
+    (0x0D, KeyCode::Backslash),
+    (0x0F, KeyCode::Numpad0),
+    (0x10, KeyCode::KeyQ),
+    (0x11, KeyCode::KeyW),
+    (0x12, KeyCode::KeyE),
+    (0x13, KeyCode::KeyR),
+    (0x14, KeyCode::KeyT),
+    (0x15, KeyCode::KeyY),
+    (0x16, KeyCode::KeyU),
+    (0x17, KeyCode::KeyI),
+    (0x18, KeyCode::KeyO),
+    (0x19, KeyCode::KeyP),
+    (0x1A, KeyCode::BracketLeft),
+    (0x1B, KeyCode::BracketRight),
+    (0x1D, KeyCode::Numpad1),
+    (0x1E, KeyCode::Numpad2),
+    (0x1F, KeyCode::Numpad3),
+    (0x20, KeyCode::KeyA),
+    (0x21, KeyCode::KeyS),
+    (0x22, KeyCode::KeyD),
+    (0x23, KeyCode::KeyF),
+    (0x24, KeyCode::KeyG),
+    (0x25, KeyCode::KeyH),
+    (0x26, KeyCode::KeyJ),
+    (0x27, KeyCode::KeyK),
+    (0x28, KeyCode::KeyL),
+    (0x29, KeyCode::Semicolon),
+    (0x2A, KeyCode::Quote),
+    // The ISO key next to Return; W3C names it after the US backslash.
+    (0x2B, KeyCode::Backslash),
+    (0x2D, KeyCode::Numpad4),
+    (0x2E, KeyCode::Numpad5),
+    (0x2F, KeyCode::Numpad6),
+    (0x30, KeyCode::IntlBackslash),
+    (0x31, KeyCode::KeyZ),
+    (0x32, KeyCode::KeyX),
+    (0x33, KeyCode::KeyC),
+    (0x34, KeyCode::KeyV),
+    (0x35, KeyCode::KeyB),
+    (0x36, KeyCode::KeyN),
+    (0x37, KeyCode::KeyM),
+    (0x38, KeyCode::Comma),
+    (0x39, KeyCode::Period),
+    (0x3A, KeyCode::Slash),
+    (0x3C, KeyCode::NumpadDecimal),
+    (0x3D, KeyCode::Numpad7),
+    (0x3E, KeyCode::Numpad8),
+    (0x3F, KeyCode::Numpad9),
+    (0x40, KeyCode::Space),
+    (0x41, KeyCode::Backspace),
+    (0x42, KeyCode::Tab),
+    (0x43, KeyCode::NumpadEnter),
+    (0x44, KeyCode::Enter),
+    (0x45, KeyCode::Escape),
+    (0x46, KeyCode::Delete),
+    (0x47, KeyCode::Insert),
+    (0x48, KeyCode::PageUp),
+    (0x49, KeyCode::PageDown),
+    (0x4A, KeyCode::NumpadSubtract),
+    (0x4B, KeyCode::F11),
+    (0x4C, KeyCode::ArrowUp),
+    (0x4D, KeyCode::ArrowDown),
+    (0x4E, KeyCode::ArrowRight),
+    (0x4F, KeyCode::ArrowLeft),
+    (0x50, KeyCode::F1),
+    (0x51, KeyCode::F2),
+    (0x52, KeyCode::F3),
+    (0x53, KeyCode::F4),
+    (0x54, KeyCode::F5),
+    (0x55, KeyCode::F6),
+    (0x56, KeyCode::F7),
+    (0x57, KeyCode::F8),
+    (0x58, KeyCode::F9),
+    (0x59, KeyCode::F10),
+    (0x5A, KeyCode::NumpadParenLeft),
+    (0x5B, KeyCode::NumpadParenRight),
+    (0x5C, KeyCode::NumpadDivide),
+    (0x5D, KeyCode::NumpadMultiply),
+    (0x5E, KeyCode::NumpadAdd),
+    (0x5F, KeyCode::Help),
+    (0x60, KeyCode::ShiftLeft),
+    (0x61, KeyCode::ShiftRight),
+    (0x62, KeyCode::CapsLock),
+    (0x63, KeyCode::ControlLeft),
+    (0x64, KeyCode::AltLeft),
+    (0x65, KeyCode::AltRight),
+    (0x66, KeyCode::SuperLeft),
+    (0x67, KeyCode::SuperRight),
+    (0x6B, KeyCode::ScrollLock),
+    (0x6C, KeyCode::PrintScreen),
+    (0x6D, KeyCode::NumLock),
+    (0x6E, KeyCode::Pause),
+    (0x6F, KeyCode::F12),
+    (0x70, KeyCode::Home),
+    (0x71, KeyCode::End),
+    (0x72, KeyCode::MediaStop),
+    (0x73, KeyCode::MediaPlayPause),
+    (0x74, KeyCode::MediaTrackPrevious),
+    (0x75, KeyCode::MediaTrackNext),
+];
+
+fn key_code(raw: u16) -> Option<KeyCode> {
+    KEYS.iter().find(|(r, _)| *r == raw).map(|(_, code)| *code)
+}
+
+pub(crate) fn scancode_to_physicalkey(scancode: u32) -> PhysicalKey {
+    u16::try_from(scancode)
+        .ok()
+        .and_then(key_code)
+        .map_or(PhysicalKey::Unidentified(NativeKeyCode::Unidentified), PhysicalKey::Code)
+}
+
+pub(crate) fn physicalkey_to_scancode(key: PhysicalKey) -> Option<u32> {
+    let PhysicalKey::Code(code) = key else { return None };
+    KEYS.iter().find(|(_, c)| *c == code).map(|(raw, _)| u32::from(*raw))
+}
+
+fn named_key(code: KeyCode) -> Option<NamedKey> {
+    Some(match code {
+        KeyCode::Space => NamedKey::Space,
+        KeyCode::Backspace => NamedKey::Backspace,
+        KeyCode::Tab => NamedKey::Tab,
+        KeyCode::Enter | KeyCode::NumpadEnter => NamedKey::Enter,
+        KeyCode::Escape => NamedKey::Escape,
+        KeyCode::Delete => NamedKey::Delete,
+        KeyCode::Insert => NamedKey::Insert,
+        KeyCode::PageUp => NamedKey::PageUp,
+        KeyCode::PageDown => NamedKey::PageDown,
+        KeyCode::Home => NamedKey::Home,
+        KeyCode::End => NamedKey::End,
+        KeyCode::ArrowUp => NamedKey::ArrowUp,
+        KeyCode::ArrowDown => NamedKey::ArrowDown,
+        KeyCode::ArrowLeft => NamedKey::ArrowLeft,
+        KeyCode::ArrowRight => NamedKey::ArrowRight,
+        KeyCode::F1 => NamedKey::F1,
+        KeyCode::F2 => NamedKey::F2,
+        KeyCode::F3 => NamedKey::F3,
+        KeyCode::F4 => NamedKey::F4,
+        KeyCode::F5 => NamedKey::F5,
+        KeyCode::F6 => NamedKey::F6,
+        KeyCode::F7 => NamedKey::F7,
+        KeyCode::F8 => NamedKey::F8,
+        KeyCode::F9 => NamedKey::F9,
+        KeyCode::F10 => NamedKey::F10,
+        KeyCode::F11 => NamedKey::F11,
+        KeyCode::F12 => NamedKey::F12,
+        KeyCode::Help => NamedKey::Help,
+        KeyCode::ShiftLeft | KeyCode::ShiftRight => NamedKey::Shift,
+        KeyCode::CapsLock => NamedKey::CapsLock,
+        KeyCode::ControlLeft => NamedKey::Control,
+        KeyCode::AltLeft => NamedKey::Alt,
+        // AROS keymaps use the right Alt key for the third level of symbols.
+        KeyCode::AltRight => NamedKey::AltGraph,
+        KeyCode::SuperLeft | KeyCode::SuperRight => NamedKey::Super,
+        KeyCode::ScrollLock => NamedKey::ScrollLock,
+        KeyCode::PrintScreen => NamedKey::PrintScreen,
+        KeyCode::NumLock => NamedKey::NumLock,
+        KeyCode::Pause => NamedKey::Pause,
+        KeyCode::MediaStop => NamedKey::MediaStop,
+        KeyCode::MediaPlayPause => NamedKey::MediaPlayPause,
+        KeyCode::MediaTrackPrevious => NamedKey::MediaTrackPrevious,
+        KeyCode::MediaTrackNext => NamedKey::MediaTrackNext,
+        _ => return None,
+    })
+}
+
+/// The text winit reports for the named keys that produce any.
+fn named_text(key: NamedKey) -> Option<&'static str> {
+    Some(match key {
+        NamedKey::Space => " ",
+        NamedKey::Backspace => "\u{8}",
+        NamedKey::Tab => "\t",
+        NamedKey::Enter => "\r",
+        NamedKey::Escape => "\u{1b}",
+        NamedKey::Delete => "\u{7f}",
+        _ => return None,
+    })
+}
+
+fn location(code: KeyCode) -> KeyLocation {
+    match code {
+        KeyCode::ShiftLeft | KeyCode::ControlLeft | KeyCode::AltLeft | KeyCode::SuperLeft => {
+            KeyLocation::Left
+        },
+        KeyCode::ShiftRight | KeyCode::AltRight | KeyCode::SuperRight => KeyLocation::Right,
+        KeyCode::Numpad0
+        | KeyCode::Numpad1
+        | KeyCode::Numpad2
+        | KeyCode::Numpad3
+        | KeyCode::Numpad4
+        | KeyCode::Numpad5
+        | KeyCode::Numpad6
+        | KeyCode::Numpad7
+        | KeyCode::Numpad8
+        | KeyCode::Numpad9
+        | KeyCode::NumpadDecimal
+        | KeyCode::NumpadEnter
+        | KeyCode::NumpadSubtract
+        | KeyCode::NumpadAdd
+        | KeyCode::NumpadMultiply
+        | KeyCode::NumpadDivide
+        | KeyCode::NumpadParenLeft
+        | KeyCode::NumpadParenRight => KeyLocation::Numpad,
+        _ => KeyLocation::Standard,
+    }
+}
+
+/// The qualifier bit a modifier key sets.
+fn modifier_qualifier(code: u16) -> u16 {
+    match code {
+        0x60 => sys::IEQUALIFIER_LSHIFT,
+        0x61 => sys::IEQUALIFIER_RSHIFT,
+        0x63 => sys::IEQUALIFIER_CONTROL,
+        0x64 => sys::IEQUALIFIER_LALT,
+        0x65 => sys::IEQUALIFIER_RALT,
+        0x66 => sys::IEQUALIFIER_LCOMMAND,
+        0x67 => sys::IEQUALIFIER_RCOMMAND,
+        _ => 0,
+    }
+}
+
+/// The qualifier once this key event has taken effect, whether or not
+/// input.device already counted the modifier key itself.
+pub(super) fn qualifier_after(raw: u16, qualifier: u16) -> u16 {
+    let bit = modifier_qualifier(raw & !sys::IECODE_UP_PREFIX);
+    if raw & sys::IECODE_UP_PREFIX != 0 {
+        qualifier & !bit
+    } else {
+        qualifier | bit
+    }
+}
+
+pub(super) fn is_modifier_key(raw: u16) -> bool {
+    modifier_qualifier(raw & !sys::IECODE_UP_PREFIX) != 0
+}
+
+/// Right Alt is AltGr on AROS keymaps, so it is not reported as Alt.
+pub(super) fn modifiers(qualifier: u16) -> Modifiers {
+    let has = |bit: u16| qualifier & bit != 0;
+    let mut state = ModifiersState::empty();
+    let mut pressed_mods = ModifiersKeys::empty();
+
+    state.set(ModifiersState::SHIFT, has(sys::IEQUALIFIER_LSHIFT | sys::IEQUALIFIER_RSHIFT));
+    state.set(ModifiersState::CONTROL, has(sys::IEQUALIFIER_CONTROL));
+    state.set(ModifiersState::ALT, has(sys::IEQUALIFIER_LALT));
+    state.set(ModifiersState::SUPER, has(sys::IEQUALIFIER_LCOMMAND | sys::IEQUALIFIER_RCOMMAND));
+
+    pressed_mods.set(ModifiersKeys::LSHIFT, has(sys::IEQUALIFIER_LSHIFT));
+    pressed_mods.set(ModifiersKeys::RSHIFT, has(sys::IEQUALIFIER_RSHIFT));
+    pressed_mods.set(ModifiersKeys::LCONTROL, has(sys::IEQUALIFIER_CONTROL));
+    pressed_mods.set(ModifiersKeys::LALT, has(sys::IEQUALIFIER_LALT));
+    pressed_mods.set(ModifiersKeys::LSUPER, has(sys::IEQUALIFIER_LCOMMAND));
+    pressed_mods.set(ModifiersKeys::RSUPER, has(sys::IEQUALIFIER_RCOMMAND));
+
+    Modifiers { state, pressed_mods }
+}
+
+/// The qualifiers the keymap looks at.
+const MAPPING_QUALIFIERS: u16 = sys::IEQUALIFIER_LSHIFT
+    | sys::IEQUALIFIER_RSHIFT
+    | sys::IEQUALIFIER_CAPSLOCK
+    | sys::IEQUALIFIER_CONTROL
+    | sys::IEQUALIFIER_LALT
+    | sys::IEQUALIFIER_RALT
+    | sys::IEQUALIFIER_NUMERICPAD;
+
+/// Text for a key through the current keymap, which produces ISO-8859-1.
+fn map_rawkey(code: u16, qualifier: u16) -> Option<SmolStr> {
+    let mut buf = [0 as c_char; 8];
+    let len = unsafe {
+        sys::aros_gui_map_rawkey(code, qualifier, buf.as_mut_ptr(), buf.len() as c_int)
+    };
+    if len <= 0 {
+        return None;
+    }
+    let bytes = &buf[..len as usize];
+    // Cursor and function keys map to CSI sequences, which are not text.
+    if bytes[0] as u8 == 0x9b {
+        return None;
+    }
+    Some(bytes.iter().map(|&b| char::from(b as u8)).collect())
+}
+
+fn printable(text: &Option<SmolStr>) -> Option<SmolStr> {
+    text.clone().filter(|text| !text.chars().any(char::is_control))
+}
+
+/// Translates an `IDCMP_RAWKEY` message, other than a wheel one.
+pub(super) fn key_event(raw: u16, qualifier: u16) -> KeyEvent {
+    let pressed = raw & sys::IECODE_UP_PREFIX == 0;
+    let code = raw & !sys::IECODE_UP_PREFIX;
+    let key_code = key_code(code);
+    let physical_key = scancode_to_physicalkey(u32::from(code));
+
+    // Left Alt is a modifier, not a symbol shift; right Alt (AltGr) is kept.
+    let mapping = qualifier & MAPPING_QUALIFIERS & !sys::IEQUALIFIER_LALT;
+    let with_ctrl = map_rawkey(code, mapping);
+    let without_ctrl = map_rawkey(code, mapping & !sys::IEQUALIFIER_CONTROL);
+    let bare = map_rawkey(code, mapping & sys::IEQUALIFIER_NUMERICPAD);
+
+    let (logical_key, key_without_modifiers, text, text_with_all_modifiers) =
+        match key_code.and_then(named_key) {
+            Some(named) => {
+                let text = named_text(named).map(SmolStr::new_static);
+                (Key::Named(named), Key::Named(named), text.clone(), text)
+            },
+            None => {
+                let logical = printable(&without_ctrl)
+                    .map_or(Key::Unidentified(NativeKey::Unidentified), Key::Character);
+                let bare = printable(&bare).map_or_else(|| logical.clone(), Key::Character);
+                (logical, bare, without_ctrl, with_ctrl)
+            },
+        };
+
+    KeyEvent {
+        physical_key,
+        logical_key,
+        text: if pressed { text } else { None },
+        location: key_code.map_or(KeyLocation::Standard, location),
+        state: if pressed { ElementState::Pressed } else { ElementState::Released },
+        repeat: qualifier & sys::IEQUALIFIER_REPEAT != 0,
+        platform_specific: KeyEventExtra {
+            key_without_modifiers,
+            text_with_all_modifiers: if pressed { text_with_all_modifiers } else { None },
+        },
+    }
+}
diff --git a/src/platform_impl/aros/mod.rs b/src/platform_impl/aros/mod.rs
new file mode 100644
index 0000000..dee2105
--- /dev/null
+++ b/src/platform_impl/aros/mod.rs
@@ -0,0 +1,144 @@
+#![cfg(target_os = "aros")]
+
+//! AROS backend: Intuition windows, driven by their IDCMP ports.
+//!
+//! The Intuition calls go through the C glue in `aros-gui-sys`.
+
+use std::fmt::{self, Display, Formatter};
+
+use smol_str::SmolStr;
+
+use crate::dpi::{PhysicalPosition, PhysicalSize};
+use crate::keyboard::Key;
+
+pub(crate) use self::event_loop::{ActiveEventLoop, EventLoop, EventLoopProxy, OwnedDisplayHandle};
+pub(crate) use self::keyboard::{physicalkey_to_scancode, scancode_to_physicalkey};
+pub use self::window::Window;
+
+mod event_loop;
+mod keyboard;
+mod window;
+
+#[derive(Default, Debug, Copy, Clone, PartialEq, Eq, Hash)]
+pub(crate) struct PlatformSpecificEventLoopAttributes {}
+
+/// The address of the Intuition window.
+#[derive(Clone, Copy, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+pub struct WindowId {
+    handle: u64,
+}
+
+impl WindowId {
+    pub const fn dummy() -> Self {
+        WindowId { handle: u64::MAX }
+    }
+}
+
+impl From<WindowId> for u64 {
+    fn from(id: WindowId) -> Self {
+        id.handle
+    }
+}
+
+impl From<u64> for WindowId {
+    fn from(handle: u64) -> Self {
+        Self { handle }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+pub struct DeviceId;
+
+impl DeviceId {
+    pub const fn dummy() -> Self {
+        DeviceId
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct PlatformSpecificWindowAttributes;
+
+#[derive(Clone, Debug)]
+pub struct OsError(&'static str);
+
+impl Display for OsError {
+    fn fmt(&self, fmt: &mut Formatter<'_>) -> Result<(), fmt::Error> {
+        fmt.write_str(self.0)
+    }
+}
+
+pub(crate) use crate::cursor::{
+    NoCustomCursor as PlatformCustomCursor, NoCustomCursor as PlatformCustomCursorSource,
+};
+pub(crate) use crate::icon::NoIcon as PlatformIcon;
+
+/// The Workbench screen.
+#[derive(Clone, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+pub struct MonitorHandle;
+
+impl MonitorHandle {
+    pub fn name(&self) -> Option<String> {
+        Some("Workbench".to_owned())
+    }
+
+    pub fn size(&self) -> PhysicalSize<u32> {
+        let (mut width, mut height) = (0, 0);
+        if unsafe { aros_gui_sys::aros_gui_screen_size(&mut width, &mut height) } != 0 {
+            return PhysicalSize::new(0, 0);
+        }
+        PhysicalSize::new(width as u32, height as u32)
+    }
+
+    pub fn position(&self) -> PhysicalPosition<i32> {
+        (0, 0).into()
+    }
+
+    pub fn scale_factor(&self) -> f64 {
+        1.0
+    }
+
+    pub fn refresh_rate_millihertz(&self) -> Option<u32> {
+        None
+    }
+
+    pub fn video_modes(&self) -> impl Iterator<Item = VideoModeHandle> {
+        std::iter::once(VideoModeHandle {
+            size: self.size().into(),
+            bit_depth: 32,
+            refresh_rate_millihertz: 60000,
+            monitor: self.clone(),
+        })
+    }
+}
+
+#[derive(Clone, Debug, Eq, Hash, PartialEq)]
+pub struct VideoModeHandle {
+    size: (u32, u32),
+    bit_depth: u16,
+    refresh_rate_millihertz: u32,
+    monitor: MonitorHandle,
+}
+
+impl VideoModeHandle {
+    pub fn size(&self) -> PhysicalSize<u32> {
+        self.size.into()
+    }
+
+    pub fn bit_depth(&self) -> u16 {
+        self.bit_depth
+    }
+
+    pub fn refresh_rate_millihertz(&self) -> u32 {
+        self.refresh_rate_millihertz
+    }
+
+    pub fn monitor(&self) -> MonitorHandle {
+        self.monitor.clone()
+    }
+}
+
+#[derive(Debug, Clone, Eq, PartialEq, Hash)]
+pub struct KeyEventExtra {
+    pub key_without_modifiers: Key,
+    pub text_with_all_modifiers: Option<SmolStr>,
+}
