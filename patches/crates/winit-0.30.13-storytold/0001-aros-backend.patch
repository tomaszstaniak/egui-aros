+    #[inline]
+    pub fn set_cursor_grab(&self, mode: window::CursorGrabMode) -> Result<(), error::ExternalError> {
+        // Intuition cannot confine the pointer; a grab switches the window to
+        // relative mouse reports (IDCMP_DELTAMOVE), which keep coming when the
+        // pointer sits at a screen edge, so a locked pointer works for looking
+        // around. Only the task that opened the window may change its IDCMP.
+        let on = !matches!(mode, window::CursorGrabMode::None);
+        unsafe { sys::aros_gui_window_set_delta_move(self.handle, on as i32) };
+        Ok(())
+    }
