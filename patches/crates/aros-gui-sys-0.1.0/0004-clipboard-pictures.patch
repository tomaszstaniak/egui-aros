+
+#[cfg(test)]
+mod picture_tests {
+    use super::*;
+
+    /// A plain ILBM reader for the tests: BMHD + ByteRun1 BODY, 24 planes, back to RGB.
+    fn decode(bmhd: &[u8; 20], body: &[u8]) -> (u32, u32, Vec<[u8; 3]>) {
+        let w = u16::from_be_bytes([bmhd[0], bmhd[1]]) as usize;
+        let h = u16::from_be_bytes([bmhd[2], bmhd[3]]) as usize;
+        assert_eq!((bmhd[8], bmhd[9], bmhd[10]), (24, 0, 1));
+        let row_bytes = w.div_ceil(16) * 2;
+        let mut pos = 0;
+        let mut unpack = || {
+            let mut out = Vec::with_capacity(row_bytes);
+            while out.len() < row_bytes {
+                let n = body[pos] as i8;
+                pos += 1;
+                if n >= 0 {
+                    out.extend_from_slice(&body[pos..pos + n as usize + 1]);
+                    pos += n as usize + 1;
+                } else if n != -128 {
+                    out.extend(std::iter::repeat_n(body[pos], (1 - n as isize) as usize));
+                    pos += 1;
+                }
+            }
+            assert_eq!(out.len(), row_bytes, "a ByteRun1 row overran its plane");
+            out
+        };
+        let mut px = vec![[0u8; 3]; w * h];
+        for y in 0..h {
+            for p in 0..24 {
+                let plane = unpack();
+                for x in 0..w {
+                    if plane[x / 8] & (0x80 >> (x % 8)) != 0 {
+                        px[y * w + x][p / 8] |= 1 << (p % 8);
+                    }
+                }
+            }
+        }
+        (w as u32, h as u32, px)
+    }
+
+    fn picture(w: u32, h: u32) -> Vec<u8> {
+        let mut v = Vec::new();
+        for y in 0..h {
+            for x in 0..w {
+                // Gradients, a noisy channel and varying alpha.
+                v.extend_from_slice(&[(x * 7) as u8, (y * 13) as u8, ((x * 31) ^ (y * 17)) as u8, (x + y) as u8]);
+            }
+        }
+        v
+    }
+
+    #[test]
+    fn odd_width_round_trips_pixel_exact() {
+        for (w, h) in [(1, 1), (17, 5), (33, 9), (255, 3), (300, 2)] {
+            let rgba = picture(w, h);
+            let (bmhd, body) = encode_ilbm(w, h, w as usize * 4, &rgba).unwrap();
+            let (dw, dh, px) = decode(&bmhd, &body);
+            assert_eq!((dw, dh), (w, h));
+            for (i, p) in px.iter().enumerate() {
+                assert_eq!(p, &rgba[i * 4..i * 4 + 3], "pixel {i} of {w}x{h}");
+            }
+        }
+    }
+
+    #[test]
+    fn stride_padding_is_ignored() {
+        let (w, h) = (5u32, 3u32);
+        let tight = picture(w, h);
+        let stride = 32;
+        let mut padded = vec![0xEEu8; stride * h as usize];
+        for y in 0..h as usize {
+            padded[y * stride..y * stride + 20].copy_from_slice(&tight[y * 20..y * 20 + 20]);
+        }
+        assert_eq!(encode_ilbm(w, h, stride, &padded).unwrap(), encode_ilbm(w, h, 20, &tight).unwrap());
+    }
+
+    #[test]
+    fn byterun1_runs_and_literals() {
+        let mut out = Vec::new();
+        byterun1(&[0; 200], &mut out);
+        assert_eq!(out, vec![0x81, 0, 0xB9, 0]); // 128 + 72
+        out.clear();
+        byterun1(&[1, 2, 3, 3, 3, 3, 4], &mut out);
+        assert_eq!(out, vec![1, 1, 2, 0xFD, 3, 0, 4]);
+        out.clear();
+        let lit: Vec<u8> = (0..130).map(|i| i as u8).collect();
+        byterun1(&lit, &mut out);
+        assert_eq!(out[0], 127);
+        assert_eq!(out[129], 1);
+    }
+
+    #[test]
+    fn limits_and_bad_input_are_refused() {
+        assert!(encode_ilbm(0, 4, 0, &[]).is_err());
+        assert!(encode_ilbm(MAX_SIDE + 1, 1, (MAX_SIDE as usize + 1) * 4, &[]).is_err());
+        assert!(encode_ilbm(4, 4, 15, &[0; 64]).is_err(), "stride below width*4");
+        assert!(encode_ilbm(4, 4, 16, &[0; 63]).is_err(), "short buffer");
+        assert!(checked_size(MAX_SIDE, MAX_SIDE).is_err(), "over MAX_BYTES");
+        assert_eq!(checked_size(8192, 8192), Ok(8192 * 8192 * 4));
+    }
+
+    #[test]
+    fn bmhd_fields() {
+        let (b, _) = encode_ilbm(640, 480, 2560, &vec![0; 640 * 480 * 4]).unwrap();
+        assert_eq!(&b[0..4], &[2, 128, 1, 224]);
+        assert_eq!(&b[8..11], &[24, 0, 1]);
+        assert_eq!(&b[14..20], &[1, 1, 2, 128, 1, 224]);
     }
 }
diff -ruN aros-gui-sys-0.1.0.orig/src/clippic.c aros-gui-sys-0.1.0/src/clippic.c
--- aros-gui-sys-0.1.0.orig/src/clippic.c	1970-01-01 01:00:00
+++ aros-gui-sys-0.1.0/src/clippic.c	2026-11-07 13:15:07
@@ -0,0 +1,224 @@
+/* Pictures on clipboard unit 0 for src/clipboard.rs. Contract: glue.h.
+
+   Reading: the clipboard's FORM type is looked at first with iffparse, so an
+   empty clipboard or text is told apart from a picture no datatype can read.
+   A picture is then opened with datatypes (DTST_CLIPBOARD, picture group,
+   PMODE_V43) and its pixels are copied with PDTM_READPIXELARRAY into the
+   caller's buffer. The clipboard is only read.
+
+   Writing: a FORM ILBM with the caller's BMHD and BODY payloads, through
+   iffparse. Libraries are opened per call and closed before returning. */
+#include <stdint.h>
+#include <string.h>
+#include <exec/memory.h>
+#include <devices/clipboard.h>
+#include <dos/dos.h>
+#include <libraries/iffparse.h>
+#include <datatypes/datatypes.h>
+#include <datatypes/datatypesclass.h>
+#include <datatypes/pictureclass.h>
+#include <intuition/classusr.h>
+#include <utility/tagitem.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/iffparse.h>
+#include <proto/datatypes.h>
+#include <clib/alib_protos.h>
+
+#include "glue.h"
+
+/* ID_ILBM, ID_BMHD and ID_BODY come from datatypes/pictureclass.h. */
+#define ID_FTXT MAKE_ID('F', 'T', 'X', 'T')
+
+#define KIND_EMPTY   0
+#define KIND_TEXT    1
+#define KIND_PICTURE 2
+
+struct clip_image {
+    struct Library *datatypes;
+    Object *object;
+    uint32_t width, height;
+};
+
+static void say(char *err, int32_t cap, const char *text, LONG code)
+{
+    size_t len;
+
+    if (cap <= 0)
+        return;
+    len = strlen(text);
+    if (len >= (size_t)cap)
+        len = cap - 1;
+    memcpy(err, text, len);
+    err[len] = '\0';
+    if (code && len + 16 < (size_t)cap) {
+        /* The DOS error text after ": ". */
+        err[len++] = ':';
+        err[len++] = ' ';
+        err[len] = '\0';
+        if (!Fault(code, NULL, (STRPTR)err + len, cap - len))
+            err[len - 2] = '\0';
+    }
+}
+
+/* The type of the clipboard's first FORM (0 when it holds none). */
+static ULONG clip_form_type(void)
+{
+    struct Library *IFFParseBase = OpenLibrary((CONST_STRPTR)"iffparse.library", 39);
+    struct IFFHandle *iff;
+    ULONG type = 0;
+
+    if (!IFFParseBase)
+        return 0;
+    iff = AllocIFF();
+    if (iff) {
+        iff->iff_Stream = (IPTR)OpenClipboard(PRIMARY_CLIP);
+        if (iff->iff_Stream) {
+            InitIFFasClip(iff);
+            if (OpenIFF(iff, IFFF_READ) == 0) {
+                if (ParseIFF(iff, IFFPARSE_STEP) == 0) {
+                    struct ContextNode *cn = CurrentChunk(iff);
+
+                    if (cn && cn->cn_ID == ID_FORM)
+                        type = cn->cn_Type;
+                }
+                CloseIFF(iff);
+            }
+            CloseClipboard((struct ClipboardHandle *)iff->iff_Stream);
+        }
+        FreeIFF(iff);
+    }
+    CloseLibrary(IFFParseBase);
+    return type;
+}
+
+void *aros_gui_clip_picture_open(int32_t *kind, uint32_t *width, uint32_t *height, char *err, int32_t cap)
+{
+    struct clip_image *ci;
+    struct BitMapHeader *bmh = NULL;
+    ULONG type = clip_form_type();
+    struct Library *DataTypesBase;
+
+    *width = *height = 0;
+    if (cap > 0)
+        err[0] = '\0';
+    if (type == 0) {
+        *kind = KIND_EMPTY;
+        return NULL;
+    }
+    if (type == ID_FTXT) {
+        *kind = KIND_TEXT;
+        return NULL;
+    }
+    *kind = KIND_PICTURE;
+
+    ci = AllocVec(sizeof(*ci), MEMF_ANY | MEMF_CLEAR);
+    if (!ci) {
+        say(err, cap, "not enough memory", 0);
+        return NULL;
+    }
+    ci->datatypes = DataTypesBase = OpenLibrary((CONST_STRPTR)"datatypes.library", 39);
+    if (!ci->datatypes) {
+        say(err, cap, "datatypes.library cannot be opened", 0);
+    } else {
+        struct TagItem tags[] = {
+            { DTA_SourceType, DTST_CLIPBOARD },
+            { DTA_GroupID, GID_PICTURE },
+            { PDTA_DestMode, PMODE_V43 },
+            { PDTA_Remap, FALSE },
+            { TAG_DONE, 0 },
+        };
+        /* For DTST_CLIPBOARD the name is the clipboard unit. */
+        ci->object = NewDTObjectA((APTR)(IPTR)PRIMARY_CLIP, tags);
+        if (!ci->object) {
+            say(err, cap, "no datatype could read the picture on the clipboard", IoErr());
+        } else {
+            struct TagItem get[] = { { PDTA_BitMapHeader, (IPTR)&bmh }, { TAG_DONE, 0 } };
+
+            if (GetDTAttrsA(ci->object, get) == 1 && bmh && bmh->bmh_Width && bmh->bmh_Height) {
+                ci->width = *width = bmh->bmh_Width;
+                ci->height = *height = bmh->bmh_Height;
+                return ci;
+            }
+            say(err, cap, "the picture on the clipboard has no size", 0);
+        }
+    }
+    if (ci->object)
+        DisposeDTObject(ci->object);
+    if (ci->datatypes)
+        CloseLibrary(ci->datatypes);
+    FreeVec(ci);
+    return NULL;
+}
+
+int32_t aros_gui_clip_picture_read(void *handle, uint8_t *rgba, uint32_t stride)
+{
+    struct clip_image *ci = handle;
+    struct pdtBlitPixelArray msg;
+
+    /* The whole width: picture.datatype's conversion loop always walks it. */
+    msg.MethodID = PDTM_READPIXELARRAY;
+    msg.pbpa_PixelData = rgba;
+    msg.pbpa_PixelFormat = PBPAFMT_RGBA;
+    msg.pbpa_PixelArrayMod = stride;
+    msg.pbpa_Left = 0;
+    msg.pbpa_Top = 0;
+    msg.pbpa_Width = ci->width;
+    msg.pbpa_Height = ci->height;
+    return DoMethodA(ci->object, (Msg)&msg) ? 1 : 0;
+}
+
+void aros_gui_clip_picture_close(void *handle)
+{
+    struct clip_image *ci = handle;
+    struct Library *DataTypesBase = ci->datatypes;
+
+    DisposeDTObject(ci->object);
+    CloseLibrary(ci->datatypes);
+    FreeVec(ci);
+}
+
+int32_t aros_gui_clip_ilbm_write(const uint8_t *bmhd, const uint8_t *body, uint32_t body_len, char *err, int32_t cap)
+{
+    struct Library *IFFParseBase = OpenLibrary((CONST_STRPTR)"iffparse.library", 39);
+    struct IFFHandle *iff;
+    int32_t rc = -1;
+
+    if (cap > 0)
+        err[0] = '\0';
+    if (!IFFParseBase) {
+        say(err, cap, "iffparse.library cannot be opened", 0);
+        return -1;
+    }
+    iff = AllocIFF();
+    if (!iff) {
+        say(err, cap, "not enough memory", 0);
+    } else {
+        iff->iff_Stream = (IPTR)OpenClipboard(PRIMARY_CLIP);
+        if (!iff->iff_Stream) {
+            say(err, cap, "the clipboard cannot be opened", 0);
+        } else {
+            InitIFFasClip(iff);
+            if (OpenIFF(iff, IFFF_WRITE) != 0) {
+                say(err, cap, "the clipboard cannot be written", 0);
+            } else {
+                if (PushChunk(iff, ID_ILBM, ID_FORM, IFFSIZE_UNKNOWN) == 0
+                    && PushChunk(iff, 0, ID_BMHD, 20) == 0
+                    && WriteChunkBytes(iff, (APTR)bmhd, 20) == 20
+                    && PopChunk(iff) == 0
+                    && PushChunk(iff, 0, ID_BODY, body_len) == 0
+                    && WriteChunkBytes(iff, (APTR)body, body_len) == (LONG)body_len
+                    && PopChunk(iff) == 0
+                    && PopChunk(iff) == 0)
+                    rc = 0;
+                else
+                    say(err, cap, "writing the picture to the clipboard failed", 0);
+                CloseIFF(iff);
+            }
+            CloseClipboard((struct ClipboardHandle *)iff->iff_Stream);
+        }
+        FreeIFF(iff);
+    }
+    CloseLibrary(IFFParseBase);
+    return rc;
+}
