From: AROS Craft ports
Subject: [PATCH] tar: std-only paths for AROS targets without the unix family

Crate: tar 0.4.46 (crates.io).
Date: 2026-11-07
Problem: std for aarch64 AROS (Raspberry Pi) does not set the unix family,
  and tar has platform code only for unix, windows and wasm32: path
  conversion, symlinks, permissions and ownership do not compile.
Rationale: take tar's wasm32 code (UTF-8 path bytes, no symlink creation,
  no permissions or ownership) on AROS targets that are not unix. x86_64
  AROS is unix and is unchanged.
Upstream-status: local port, not submitted.
Removal: when the aarch64 AROS std has the unix family.
---
diff --git a/src/entry.rs b/src/entry.rs
--- a/src/entry.rs
+++ b/src/entry.rs
@@ -593,7 +593,7 @@
             }
             return Ok(Unpacked::__Nonexhaustive);
 
-            #[cfg(target_arch = "wasm32")]
+            #[cfg(any(target_arch = "wasm32", all(target_os = "aros", not(unix))))]
             #[allow(unused_variables)]
             fn symlink(src: &Path, dst: &Path) -> io::Result<()> {
                 Err(io::Error::new(io::ErrorKind::Other, "Not implemented"))
@@ -604,7 +604,7 @@
                 ::std::os::windows::fs::symlink_file(src, dst)
             }
 
-            #[cfg(all(unix, not(target_arch = "wasm32")))]
+            #[cfg(all(unix, not(any(target_arch = "wasm32", all(target_os = "aros", not(unix))))))]
             fn symlink(src: &Path, dst: &Path) -> io::Result<()> {
                 ::std::os::unix::fs::symlink(src, dst)
             }
@@ -730,7 +730,7 @@
             })
         }
 
-        #[cfg(all(unix, not(target_arch = "wasm32")))]
+        #[cfg(all(unix, not(any(target_arch = "wasm32", all(target_os = "aros", not(unix))))))]
         fn _set_ownerships(
             dst: &Path,
             f: &Option<&mut std::fs::File>,
@@ -771,7 +771,7 @@
         }
 
         // Windows does not support posix numeric ownership IDs
-        #[cfg(any(windows, target_arch = "wasm32"))]
+        #[cfg(any(windows, any(target_arch = "wasm32", all(target_os = "aros", not(unix)))))]
         fn _set_ownerships(
             _: &Path,
             _: &Option<&mut std::fs::File>,
@@ -801,7 +801,7 @@
             })
         }
 
-        #[cfg(all(unix, not(target_arch = "wasm32")))]
+        #[cfg(all(unix, not(any(target_arch = "wasm32", all(target_os = "aros", not(unix))))))]
         fn _set_perms(
             dst: &Path,
             f: Option<&mut std::fs::File>,
@@ -845,7 +845,7 @@
             }
         }
 
-        #[cfg(target_arch = "wasm32")]
+        #[cfg(any(target_arch = "wasm32", all(target_os = "aros", not(unix))))]
         #[allow(unused_variables)]
         fn _set_perms(
             dst: &Path,
@@ -857,7 +857,7 @@
             Err(io::Error::new(io::ErrorKind::Other, "Not implemented"))
         }
 
-        #[cfg(all(unix, not(target_arch = "wasm32"), feature = "xattr"))]
+        #[cfg(all(unix, not(any(target_arch = "wasm32", all(target_os = "aros", not(unix)))), feature = "xattr"))]
         fn set_xattrs(me: &mut EntryFields, dst: &Path) -> io::Result<()> {
             use std::ffi::OsStr;
             use std::os::unix::prelude::*;
@@ -895,7 +895,7 @@
         }
         // Windows does not completely support posix xattrs
         // https://en.wikipedia.org/wiki/Extended_file_attributes#Windows_NT
-        #[cfg(any(windows, not(feature = "xattr"), target_arch = "wasm32"))]
+        #[cfg(any(windows, not(feature = "xattr"), any(target_arch = "wasm32", all(target_os = "aros", not(unix)))))]
         fn set_xattrs(_: &mut EntryFields, _: &Path) -> io::Result<()> {
             Ok(())
         }
